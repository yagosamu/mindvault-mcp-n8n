# MindVault — configuration reference. Copy to .env and fill in.
#   cp .env.example .env

# ── n8n ───────────────────────────────────────────────────────────────────────
# Encrypts stored credentials. Generate once and never change it, or every
# credential saved in n8n becomes undecryptable.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_HOST_PORT=5678
GENERIC_TIMEZONE=America/Sao_Paulo

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Host ports, shifted off 6333/6334 so this stack coexists with the other
# projects in this folder. Tools on your machine (and the MCP server) use these.
QDRANT_HOST_PORT=6353
QDRANT_GRPC_PORT=6354

# What the MCP server connects to, from the host.
QDRANT_URL=http://localhost:6353
# Self-hosted Qdrant runs without auth by default — leave blank locally.
QDRANT_API_KEY=
QDRANT_COLLECTION=mindvault

# NOTE: inside n8n, the Qdrant URL is http://qdrant:6333 — the service name and
# the INTERNAL port. Containers talk over the compose network, not via localhost.

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Used by the MCP server. n8n keeps its own copy in its credential store.
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── GitHub vault ──────────────────────────────────────────────────────────────
# The repository the notes live in; Obsidian syncs it with the Git plugin.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
