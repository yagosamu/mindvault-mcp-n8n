            {
              "id": "r1",
              "name": "output",
              "type": "string",
              "value": "={{ $json.choices[0].message.content }}"
            }
          ]
        },
        "options": {}
      },
      "id": "1b5ae64e-2aff-4511-8bb7-fd9f0538fd37",
      "name": "Resposta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1328,
        304
      ],
      "notes": "Extrai só o texto da resposta no campo 'output', que o Chat Trigger exibe como mensagem limpa."
    }
